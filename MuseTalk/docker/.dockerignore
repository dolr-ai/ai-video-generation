# MuseTalk Docker - Ignore unnecessary files for faster builds

# Version control
.git/
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments (will create new one in container)
.venv/
venv/
ENV/
env/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs and temporary files
*.log
logs/
temp/
tmp/
*.tmp

# Results and output directories (will be recreated)
results/
outputs/
generated/

# Large model files (should be mounted as volumes)
models/
*.pth
*.bin
*.safetensors

# Docker related
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation (not needed in container)
docs/
*.md
README*

# FastAPI server logs (will be created at runtime)
fastapi_server/*.log
fastapi_server/logs/
fastapi_server/storage/

# Test files and multimedia (will be mounted)
multimedia/
test_*

# Jupyter notebooks and development files  
*.ipynb
.jupyter/

# Package manager caches
.npm/
.pip/
pip-wheel-metadata/

# Coverage reports
htmlcov/
.coverage
.pytest_cache/
coverage.xml

# Backup and temporary files
*.bak
*.backup
*.old
*.orig